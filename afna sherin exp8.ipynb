   "source": [
    "#dictionary\n",
    "roll=input(\"enter roll numbers:\").split()\n",
    "name=input(\"enter names of students:\").split()\n",
    "result=dict(zip(roll,name))\n",
    "print(\"dictionary:\",result)\n",
    "print(\"ascending:\",dict(sorted(result.items())))\n",
    "print(\"descending:\",dict(sorted(result.items(),reverse=True)))\n"
   ]
